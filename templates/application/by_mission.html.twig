{% extends 'base.html.twig' %}

{% block title %}Candidatures - {{ mission.title }}{% endblock %}

{% block body %}
    <h1>Candidatures pour "{{ mission.title }}"</h1>

    {% set acceptedApplication = null %}
    {% for application in applications %}
        {% if application.statusApplication.label == 'acceptée' %}
            {% set acceptedApplication = application %}
        {% endif %}
    {% endfor %}

    {% if acceptedApplication %}
        <ul>
            <li>
                <p><strong>{{ acceptedApplication.user.firstname }} {{ acceptedApplication.user.lastname }}</strong> ({{ acceptedApplication.user.email }})</p>
                <p>{{ acceptedApplication.motivation }}</p>
                <p>Statut : {{ acceptedApplication.statusApplication.label }}</p>
                <a href="{{ path('app_application_show', {'id': acceptedApplication.id}) }}">Voir le détail</a>
            </li>
        </ul>
    {% else %}
        {% set pendingApplications = [] %}
        {% for application in applications %}
            {% if application.statusApplication.label != 'rejetée' %}
                {% set pendingApplications = pendingApplications|merge([application]) %}
            {% endif %}
        {% endfor %}

        {% if pendingApplications|length == 0 %}
            <p>Aucune candidature pour le moment.</p>
        {% else %}
            <ul>
                {% for application in pendingApplications %}
                    <li>
                        <p><strong>{{ application.user.firstname }} {{ application.user.lastname }}</strong> ({{ application.user.email }})</p>
                        <p>{{ application.motivation }}</p>
                        <p>Statut : {{ application.statusApplication.label }}</p>
                        <a href="{{ path('app_application_show', {'id': application.id}) }}">Voir le détail</a>

                        <form method="post" action="{{ path('app_application_validate', {'id': application.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir valider cette candidature ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ application.id) }}">
                            <button class="btn btn-success">Valider la candidature</button>
                        </form>
                        <form method="post" action="{{ path('app_application_reject', {'id': application.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir rejeter cette candidature ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ application.id) }}">
                            <button class="btn btn-danger">Rejeter la candidature</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endif %}

    <a href="{{ path('app_mission_show', {'id': mission.id}) }}">Retour à la mission</a>
{% endblock %}

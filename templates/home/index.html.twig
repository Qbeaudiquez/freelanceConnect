{% set isMissions = true %}
{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <h1>Bienvenue sur FreelanceConnect</h1>
    <h2>Liste des 5 dernières missions</h2>
    <ul>
        {% for mission in missions %}
            <li>
                <a href="{{ path('app_mission_show', {'id': mission.id}) }}">{{ mission.title }}</a>
                - Budget : {{ mission.budget }} €
                - Date limite : {{ mission.deadline|date('d/m/Y') }}
                - Langue : {{ mission.language }}
            </li>
        {% else %}
            <li>Aucune mission disponible pour le moment.</li>
            {% set isMissions = false %}
        {% endfor %}
    </ul>
    {% if isMissions %}
        <a href="{{ path('app_missions') }}">Voir toutes les missions</a>
    {% endif %}
    
{% endblock %}

{% set isMissions = true %}
{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">Bienvenue sur FreelanceConnect</h1>
    <h2 class="h4 mb-3">Les 5 dernières missions</h2>
    <div class="list-group mb-3">
        {% for mission in missions %}
            <a href="{{ path('app_mission_show', {'id': mission.id}) }}" class="list-group-item list-group-item-action">
                <strong>{{ mission.title }}</strong>
                — Budget : {{ mission.budget }} €
                — Date limite : {{ mission.deadline|date('d/m/Y') }}
                — Langue : {{ mission.language }}
        {% else %}
            <p>Aucune mission disponible pour le moment.</p>
        {% endfor %}
    </div>

    {% if missions is not empty %}
        <a href="{{ path('app_missions') }}" class="btn btn-primary">Voir toutes les missions</a>
    {% endif %}
</div>
{% endblock %}
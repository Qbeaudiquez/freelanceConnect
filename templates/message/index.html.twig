{% extends 'base.html.twig' %}

{% block title %}Messagerie — {{ mission.title }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-1">Messagerie</h1>
    <h2 class="h5 text-muted mb-4">{{ mission.title }}</h2>

    <div class="mb-4">
        {% for message in messages %}
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between">
                        <strong>{{ message.sender.firstname }} {{ message.sender.lastname }}</strong>
                        <small class="text-muted">{{ message.sentAt|date('d/m/Y H:i') }}</small>
                    </div>
                    <p class="mb-0">{{ message.content }}</p>
                </div>
            </div>
        {% else %}
            <p class="text-muted">Aucun message pour le moment. Démarrez la conversation !</p>
        {% endfor %}
    </div>

    <form method="post" data-turbo="false">
        <input type="hidden" name="_token" value="{{ csrf_token('send_message') }}">
        <div class="mb-2">
            <textarea name="content" rows="3" class="form-control" placeholder="Votre message..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Envoyer</button>
    </form>
</div>
{% endblock %}
{% extends 'dashboard/base.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block dashboard_body %}
    <h2>Liste des utilisateurs</h2>
    <ul>
        {% for user in users %}
            <li>
                <h3>{{ user.firstname }} {{ user.lastname }}</h3>
                <p>Email : {{ user.email }}</p>
                <p>Rôle :
                    {% if 'ROLE_ADMIN' in user.roles %}
                        Administrateur
                    {% elseif 'ROLE_CLIENT' in user.roles %}
                        Client
                    {% else %}
                        Freelance
                    {% endif %}
                </p>
                {% if app.user != user %}
                    <form method="post" action="{{ path('app_dashboard_admin_user_ban', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir bannir cet utilisateur ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ user.id) }}">
                        <button class="btn btn-danger">Bannir</button>
                    </form>
                {% endif %}
            </li>
            
        {% else %}
            <li>Aucun utilisateur trouvé.</li>
        {% endfor %}
    </ul>
{% endblock %}
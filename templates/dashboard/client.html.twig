{% extends 'dashboard/base.html.twig' %}

{% block title %}Client Dashboard{% endblock %}

{% block dashboard_body %}
<ul>
    {% for mission in missions %}
        <li>
            <h2>{{ mission.title }}</h2>
            <p>{{ mission.description }}</p>
            <a href="{{ path('app_mission_show', {'id': mission.id}) }}">Voir la mission</a>
        </li>
    {% else %}
        <li>Aucune mission trouvée.</li>
    {% endfor %}
</ul>
<button class="btn btn-primary"><a href="{{ path('app_mission_new') }}" style="color: white; text-decoration: none;">Créer une nouvelle mission</a></button>
{% endblock %}
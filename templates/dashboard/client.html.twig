{% extends 'dashboard/base.html.twig' %}

{% block title %}Client Dashboard{% endblock %}

{% block dashboard_body %}
<div class="container py-4 d-flex flex-column" style="min-height: calc(100vh - 220px);">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Vos missions</h2>
        <a href="{{ path('app_mission_new') }}" class="btn btn-success">Créer une nouvelle mission</a>
    </div>

    {% for mission in missions %}
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h3 class="h5">{{ mission.title }}</h3>
                    <span class="badge bg-info">{{ mission.statusMission.label }}</span>
                </div>
                <p>{{ mission.description }}</p>
                <a href="{{ path('app_mission_show', {'id': mission.id}) }}" class="btn btn-primary btn-sm">Voir la mission</a>
                <a href="{{ path('app_message_index', {'id': mission.id}) }}" class="btn btn-outline-primary btn-sm">Voir la messagerie</a>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucune mission trouvée.</p>
    {% endfor %}
</div>
{% endblock %}
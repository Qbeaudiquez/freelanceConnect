{% extends 'dashboard/base.html.twig' %}

{% block title %}Freelance Dashboard{% endblock %}

{% block dashboard_body %}
<div class="container py-4">
    <h2 class="mb-4">Vos candidatures</h2>
    {% for application in applications %}
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5">{{ application.mission.title }}</h3>
                <p>{{ application.mission.description }}</p>
                <p><strong>Statut :</strong> {{ application.statusApplication.label }}</p>
                <a href="{{ path('app_mission_show', {'id': application.mission.id}) }}" class="btn btn-primary btn-sm">Voir la mission</a>
                <a href="{{ path('app_application_show', {'id': application.id}) }}" class="btn btn-outline-primary btn-sm">Voir la candidature</a>
                {% if application.statusApplication.label == 'acceptée' %}
                    <a href="{{ path('app_message_index', {'id': application.mission.id}) }}" class="btn btn-outline-success btn-sm">Voir la messagerie</a>
                {% endif %}
        </div>
    {% else %}
        <p class="text-muted">Aucune candidature trouvée.</p>
    {% endfor %}
</div>
{% endblock %}


{% extends 'dashboard/base.html.twig' %}

{% block title %}Freelance Dashboard{% endblock %}

{% block dashboard_body %}
<div class="container py-4">
    <h2 class="mb-4">Vos candidatures</h2>
    {% for application in applications %}
        <div class="card mb-3">
            <div class="card-body">
                <h3 class="h5">{{ application.mission.title }}</h3>
                <p>{{ application.mission.description }}</p>
                <p><strong>Statut :</strong> {{ application.statusApplication.label }}</p>
                <a href="{{ path('app_mission_show', {'id': application.mission.id}) }}" class="btn btn-primary btn-sm">Voir la mission</a>
                <a href="{{ path('app_application_show', {'id': application.id}) }}" class="btn btn-outline-primary btn-sm">Voir la candidature</a>
                {% if application.statusApplication.label == 'acceptée' %}
                    <a href="{{ path('app_message_index', {'id': application.mission.id}) }}" class="btn btn-outline-success btn-sm">Voir la messagerie</a>
                {% endif %}
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucune candidature trouvée.</p>
    {% endfor %}
     <div class="card mb-3 flex-grow-1 d-flex flex-column" style="min-height: 0; max-height: 40vh;">
            <div class="card-body d-flex flex-column" style="min-height: 0;">
                <h3 class="h5">Liens projets</h3>
                <ul class="list-unstyled flex-grow-1 mb-3" style="overflow-y: auto; min-height: 0;">
                    {% if links is empty %}
                        <li class="text-muted">Aucun lien ajouté.</li>
                    {% endif %}
                    {% for link in links %}
                        <li>
                            <p>{{ link.label }} : <a href="{{ link.url }}" target="_blank">{{ link.url }}</a></p>
                        </li>
                    {% endfor %}
                </ul>
                <form method="post" action="{{ path('app_link_new') }}">
                    <div class="mb-2">
                        <label for="label" class="form-label small mb-1">Label</label>
                        <input type="text" class="form-control form-control-sm" id="label" name="label" required>
                    </div>
                    <div class="mb-2">
                        <label for="url" class="form-label small mb-1">URL</label>
                        <input type="url" class="form-control form-control-sm" id="url" name="url" required>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Ajouter un lien</button>
                </form>
            </div>
        </div>
</div>
{% endblock %}


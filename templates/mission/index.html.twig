{% extends 'base.html.twig' %}

{% block title %}Liste des missions{% endblock %}

{% block body %}
    <h1>Liste des missions</h1>
    <ul>
        {% for mission in missions %}
            <li>
                <a href="{{ path('app_mission_show', {'id': mission.id}) }}">{{ mission.title }}</a>
                - Budget : {{ mission.budget }} €
                - Date limite : {{ mission.deadline|date('d/m/Y') }}
                - Langue : {{ mission.language }}
            </li>
        {% else %}
            <li>Aucune mission disponible pour le moment.</li>
        {% endfor %}
    </ul>
{% endblock %}